<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_t">t</variable>
    <variable id="var_a">a</variable>
    <variable id="var_b">b</variable>
    <variable id="var_c">c</variable>
    <variable id="var_time">time</variable>
    <variable id="var_height">height</variable>
  </variables>
  <block type="procedures_defreturn" id="func_rocket_height" x="10" y="10">
    <mutation>
      <arg name="t" varid="var_t"></arg>
    </mutation>
    <field name="NAME">rocket_height</field>
    <comment pinned="false" h="80" w="160">Calculates height based on the polynomial.</comment>
    <statement name="STACK">
      <block type="essentials_var_set" id="set_a">
        <field name="VAR" id="var_a">a</field>
        <value name="VALUE">
          <block type="essentials_num_literal" id="val_a">
            <field name="NUM">5</field>
          </block>
        </value>
        <next>
          <block type="essentials_var_set" id="set_b">
            <field name="VAR" id="var_b">b</field>
            <value name="VALUE">
              <block type="essentials_num_literal" id="val_b">
                <field name="NUM">3</field>
              </block>
            </value>
            <next>
              <block type="essentials_var_set" id="set_c">
                <field name="VAR" id="var_c">c</field>
                <value name="VALUE">
                  <block type="essentials_num_literal" id="val_c">
                    <field name="NUM">2</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <value name="RETURN">
      <block type="essentials_num_arithmetic" id="add_term_c">
        <field name="OP">ADD</field>
        <value name="A">
          <block type="essentials_num_arithmetic" id="add_term_b">
            <field name="OP">ADD</field>
            <value name="A">
              <block type="essentials_num_arithmetic" id="mul_term_a">
                <field name="OP">MULTIPLY</field>
                <value name="A">
                  <block type="essentials_var_get" id="get_a">
                    <field name="VAR" id="var_a">a</field>
                  </block>
                </value>
                <value name="B">
                  <block type="essentials_num_arithmetic" id="pow_t">
                    <field name="OP">POWER</field>
                    <value name="A">
                      <block type="essentials_var_get" id="get_t_power">
                        <field name="VAR" id="var_t">t</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="essentials_num_literal" id="num_2">
                        <field name="NUM">2</field>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </value>
            <value name="B">
              <block type="essentials_num_arithmetic" id="mul_term_b">
                <field name="OP">MULTIPLY</field>
                <value name="A">
                  <block type="essentials_var_get" id="get_b">
                    <field name="VAR" id="var_b">b</field>
                  </block>
                </value>
                <value name="B">
                  <block type="essentials_var_get" id="get_t_simple">
                    <field name="VAR" id="var_t">t</field>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </value>
        <value name="B">
          <block type="essentials_var_get" id="get_c">
            <field name="VAR" id="var_c">c</field>
          </block>
        </value>
      </block>
    </value>
  </block>
  <block type="controls_for" id="loop_time" x="10" y="450">
    <field name="VAR" id="var_time">time</field>
    <value name="FROM">
      <shadow type="math_number" id="start_0">
        <field name="NUM">0</field>
      </shadow>
    </value>
    <value name="TO">
      <shadow type="math_number" id="end_3">
        <field name="NUM">3</field>
      </shadow>
    </value>
    <value name="BY">
      <shadow type="math_number" id="step_1">
        <field name="NUM">1</field>
      </shadow>
    </value>
    <statement name="DO">
      <block type="essentials_var_set" id="set_height">
        <field name="VAR" id="var_height">height</field>
        <value name="VALUE">
          <block type="procedures_callreturn" id="call_rocket_height">
            <mutation name="rocket_height">
              <arg name="t"></arg>
            </mutation>
            <value name="ARG0">
              <block type="essentials_var_get" id="get_time_for_call">
                <field name="VAR" id="var_time">time</field>
              </block>
            </value>
          </block>
        </value>
        <next>
          <block type="text_print" id="print_result">
            <value name="TEXT">
                <block type="text_concat">
                    <value name="ADD0">
                        <block type="text">
                            <field name="TEXT">At t = </field>
                        </block>
                    </value>
                    <value name="ADD1">
                        <block type="text_concat">
                            <value name="ADD0">
                                <block type="essentials_var_get">
                                    <field name="VAR" id="var_time">time</field>
                                </block>
                            </value>
                            <value name="ADD1">
                                <block type="text_concat">
                                    <value name="ADD0">
                                        <block type="text">
                                            <field name="TEXT">s: Height = </field>
                                        </block>
                                    </value>
                                    <value name="ADD1">
                                        <block type="text_concat">
                                            <value name="ADD0">
                                                <block type="essentials_var_get">
                                                    <field name="VAR" id="var_height">height</field>
                                                </block>
                                            </value>
                                            <value name="ADD1">
                                                <block type="text">
                                                    <field name="TEXT"> meters</field>
                                                </block>
                                            </value>
                                        </block>
                                    </value>
                                </block>
                            </value>
                        </block>
                    </value>
                </block>
            </value>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
